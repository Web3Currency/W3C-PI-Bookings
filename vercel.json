{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --include=dev --workspace=@workspace/pibooking --include-workspace-root",
  "buildCommand": "npm run build --workspace=@workspace/pibooking",
  "outputDirectory": "artifacts/pibooking/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
